# GPU image for real 3DGS rasterization via gsplat.
# Prefer LRZ Enroot (scripts/lrz/bootstrap.sh) from a Mac — do not build this
# nvidia/cuda image on Apple Silicon. On a Linux CUDA host:
#   docker build -f docker/Dockerfile.gpu -t splat-explorer-gpu .
#   docker run --gpus all splat-explorer-gpu repair-job --job-dir /data/job
#
# Requires the NVIDIA container toolkit. gsplat compiles CUDA kernels on first
# use, so the CUDA *devel* image (with nvcc) is required, not the runtime image.

FROM nvidia/cuda:12.4.1-devel-ubuntu22.04

# python3-venv supplies ensurepip. Without it, `python -m venv` leaves an
# interpreter that cannot run `python -m pip` (the ArtiFixer GPU setup venv).
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 python3-pip python3-venv python3.11-venv git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# torch must match the CUDA version of the base image.
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cu124
RUN pip install --no-cache-dir \
    "numpy>=1.26" "pillow>=10.0" "pyyaml>=6.0" "scipy>=1.11" \
    "openai>=1.40" "gsplat>=1.4"

# Qwen-Image-Edit is the scene-run backup. The default image leaves it out
# (QWEN_required=false); CliRelay gpt-image-2.5 edits off-GPU.
#   docker build --build-arg INSTALL_QWEN=1 -f docker/Dockerfile.gpu -t splat-explorer-gpu .
ARG INSTALL_QWEN=0
RUN if [ "$INSTALL_QWEN" = "1" ]; then \
      pip install --no-cache-dir \
        "diffusers>=0.36.0" "transformers>=4.51.3" "accelerate>=1.2.0" \
        "safetensors>=0.4.5"; \
    fi

COPY pyproject.toml README.md ./
COPY src ./src
COPY configs ./configs
RUN pip install --no-cache-dir --no-deps .

# Select the gsplat backend at runtime:
#   splat-explorer --config configs/gpu.yaml render-test   (renderer.backend: gsplat)
# Packed LRZ / CUDA refine jobs:
#   python -m splat_explorer.repair_lrz --job-dir /workspace/inputs/<id>
# Scene-runs edit RGB through CliRelay (gpt-image-2.5) off this GPU.
# Rebuild with INSTALL_QWEN=1 when QWEN_required=true.
ENTRYPOINT ["splat-explorer"]
CMD ["render-test"]
